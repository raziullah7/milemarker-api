# Every variable is optional: each has a default that works with no .env at all.
# Copy this file to .env and set only what you want to change.
#
# Compose reads .env by itself and passes each variable read by the API on to the
# containers. For the API run from source, use: uv run --env-file .env python manage.py ...
# An empty value counts as not set.

# Read by the API. Django's secret key. Nothing in this service signs anything, so when it
# is empty a random key is made at start-up. Never commit a real one.
DJANGO_SECRET_KEY=

# Read by the API. 1 turns on Django's debug mode. Error answers are JSON either way.
DJANGO_DEBUG=0

# Read by the API. The host names the API answers to, separated by commas; any other gets
# 400 invalid_request. 127.0.0.1 is always allowed, whatever this says: the container's
# health check asks under that name.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Read by the API. How many proxies in front of the API to trust when finding a client's
# address for the rate limit. 0 while nothing stands in front of it.
DJANGO_NUM_PROXIES=0

# Read by the API, when run from source. Where PostgreSQL is; follow POSTGRES_PORT if you
# change it. Compose gives the containers their own value, the "db" service.
DATABASE_URL=postgresql://milemarker:milemarker@127.0.0.1:5432/milemarker

# Read by the API, when run from source. The Redis that holds the caches and the rate-limit
# counters; empty means each process uses its own memory. Compose gives the containers
# their own value, the "redis" service. To use the stack's Redis from source:
# redis://127.0.0.1:6379/0
REDIS_URL=

# Read by the API. Routing server URL templates, separated by commas, each containing
# {coords}, tried in order; at most two. Empty means the two public servers.
ROUTING_SERVERS=

# Read by the API (gunicorn). The number of worker processes.
WEB_CONCURRENCY=2

# Read by the API. The lowest level of message written to the log.
LOG_LEVEL=INFO

# Read by Compose only. The port the API is published on, on 127.0.0.1.
API_PORT=8000

# Read by Compose only. The port PostgreSQL is published on, on 127.0.0.1.
POSTGRES_PORT=5432

# Read by Compose only. The port Redis is published on, on 127.0.0.1.
REDIS_PORT=6379

# Read by Compose only, once nginx is in the stack (the next release): the address its port
# is published on. Until then the API's port stays on 127.0.0.1 whatever this says.
BIND_ADDRESS=127.0.0.1
