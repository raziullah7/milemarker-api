# Every variable is optional: each has a default that works with docker-compose.yml.
# Copy this file to .env to change one. Docker Compose reads .env by itself;
# for local commands use: uv run --env-file .env python manage.py ...

# Where PostgreSQL is. The default is the Compose database on this machine.
DATABASE_URL=postgresql://milemarker:milemarker@localhost:5432/milemarker

# Nothing in this service signs anything, so the built-in default is fine locally.
DJANGO_SECRET_KEY=change-me-in-a-real-deployment

# 1 turns on Django's debug mode. Error responses are JSON either way.
DJANGO_DEBUG=0

# Only read by docker-compose.yml: the port PostgreSQL is published on.
POSTGRES_PORT=5432
