# Local state that must not reach the image: history, a Windows virtual environment
# (the image builds its own), caches, and local settings that may hold secrets.
.git
.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
.env*
!.env.example


