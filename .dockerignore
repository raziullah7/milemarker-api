# Local state that must not reach the image: history, a Windows virtual environment
# (the image builds its own), caches, and local settings that may hold secrets.
.git
.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
.env*
!.env.example

# The viewer's packages, installed on the machine; an image installs its own.
node_modules
**/node_modules

# Research working data, fetched again by its scripts.
docs/plan/research/cache
docs/plan/research/out
